{
  "name": "competitive-programmers-handbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Bun-powered book pipeline: Markdown + KaTeX + TikZ to HTML, PDF, and EPUB.",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "build:html": "bun scripts/build.ts --html",
    "build:pdf": "bun scripts/build.ts --pdf",
    "build:epub": "bun scripts/build.ts --epub",
    "lint:content": "bun scripts/lint.ts",
    "doctor": "bun scripts/doctor.ts",
    "prepare": "bun run fonts",
    "fonts": "bun scripts/fonts.ts",
    "test": "bun test",
    "clean": "bun scripts/clean.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@shikijs/markdown-it": "^4.6.0",
    "epub-gen-memory": "^1.1.2",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.25",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "node-tikzjax": "^1.0.5",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.65.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/markdown-it": "^14.1.2",
    "bun-types": "^1.4.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
